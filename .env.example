# Required runtime keys
JINA_API_KEY=
OPENROUTER_API_KEY=

# Optional model and service overrides
LLM_MODEL=qwen/qwen3-8b
DEMO_ACCESS_CODE=
DEMO_MIN_REQUEST_INTERVAL=3
DEMO_MAX_QUESTIONS=20
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_QUERY_TASK=retrieval.query
EMBEDDING_DOCUMENT_TASK=retrieval.passage
RERANKER_MODEL=jina-reranker-v2-base-multilingual
REQUEST_TIMEOUT=90

# Query transformation is disabled by default to reduce latency.
RAG_QUERY_TRANSFORMATION=false
